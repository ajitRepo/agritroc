datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  phone         String    @unique
  fullName      String?   @map("full_name")
  city          String?
  address       String?
  avatarUrl     String?   @map("avatar_url")
  bio           String?
  ratingAvg     Float     @default(0) @map("rating_avg")
  ratingCount   Int       @default(0) @map("rating_count")
  exchangeCount Int       @default(0) @map("exchange_count")
  isAdmin       Boolean   @default(false) @map("is_admin")
  isVerified    Boolean   @default(true) @map("is_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastSeenAt    DateTime? @map("last_seen_at")

  offers                 Offer[]
  conversationsInitiated Conversation[] @relation("initiator")
  conversationsReceived  Conversation[] @relation("owner")
  messages               Message[]
  ratingsGiven           Rating[]       @relation("reviewer")
  ratingsReceived        Rating[]       @relation("reviewed")

  @@map("users")
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone, code])
  @@map("otp_codes")
}

model Offer {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  title           String
  description     String?
  resourceType    String   @map("resource_type") // land, livestock, seeds, machinery, production, other
  offeredResource String   @map("offered_resource")
  wantedResource  String   @map("wanted_resource")
  complementType  String   @default("none") @map("complement_type") // none, money, other
  complementDesc  String?  @map("complement_desc")
  location        String
  latitude        Float?
  longitude       Float?
  status          String   @default("active") // active, completed, cancelled
  viewsCount      Int      @default(0) @map("views_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  images        OfferImage[]
  conversations Conversation[]

  @@index([userId])
  @@index([resourceType])
  @@index([status])
  @@index([location])
  @@map("offers")
}

model OfferImage {
  id        String   @id @default(cuid())
  offerId   String   @map("offer_id")
  imageUrl  String   @map("image_url")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@map("offer_images")
}

model Conversation {
  id          String   @id @default(cuid())
  offerId     String   @map("offer_id")
  initiatorId String   @map("initiator_id")
  ownerId     String   @map("owner_id")
  status      String   @default("open") // open, closed, archived
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  offer     Offer     @relation(fields: [offerId], references: [id], onDelete: Cascade)
  initiator User      @relation("initiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  owner     User      @relation("owner", fields: [ownerId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([offerId, initiatorId])
  @@index([initiatorId])
  @@index([ownerId])
  @@map("conversations")
}

model Message {
  id             String    @id @default(cuid())
  conversationId String    @map("conversation_id")
  senderId       String    @map("sender_id")
  content        String
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

model Rating {
  id         String   @id @default(cuid())
  reviewerId String   @map("reviewer_id")
  reviewedId String   @map("reviewed_id")
  offerId    String?  @map("offer_id")
  score      Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  reviewer User @relation("reviewer", fields: [reviewerId], references: [id])
  reviewed User @relation("reviewed", fields: [reviewedId], references: [id])

  @@unique([reviewerId, reviewedId, offerId])
  @@map("ratings")
}
